APP_PIN_HASH=base64:ganti-dengan-output-npm-run-hash-pin

# Minimal 32 karakter acak
SESSION_SECRET=

GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Tempel seluruh JSON key Service Account (satu baris), atau path ke file JSON lokal
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternatif jika tidak memakai GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Cache lokal (opsional). Default: .data/thumbs dan .data/video di folder project.
# Di Railway, arahkan ke volume disk agar cache bertahan antar deploy.
# THUMB_CACHE_DIR=
# THUMB_CACHE_MAX_MB=1024
# VIDEO_CACHE_DIR=
# VIDEO_CACHE_MAX_MB=2048
# VIDEO_TRANSCODE_MAX_MB=512
